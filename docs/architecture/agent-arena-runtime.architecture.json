  "cards": [
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "SPA and sandbox never see APPWRITE_API_KEY, FERNET_KEY, or HOST_* keys",
        "Sandbox callbacks require X-Sandbox-Token bound to one battle_id; legacy X-Internal-Key is ignored",
        "BYOK stores Fernet ciphertext; ssrf.validate_base_url blocks private/link-local egress"
      ]
    },
    {
      "dot": "cyan",
      "title": "Primary request",
      "items": [
        "Browser logs in via Appwrite; SPA sends Bearer JWT to POST /battles",
        "FastAPI persists queued; BackgroundTasks call sandbox_launcher.start_battle",
        "ARENA_USE_MOCK=1 swaps mock_runner for Modal Sandbox; skills mount at /opt/arena-skills"
      ]
    },
    {
      "dot": "emerald",
      "title": "Live stream and score",
      "items": [
        "event_bus writes battle_events; LiveBattle uses GET /battles/:id/stream",
        "Judge is host Kimi-K3 over modal_proxy; artifacts are redacted before scoring",
        "Elo updates on finalize; reaper fails stale queued/running battles every minute"
      ]
    }
  ]
