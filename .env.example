# --- Backend (Modal) ---
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a92f61d001bf8be437e
APPWRITE_DATABASE_ID=6a92f64c002303d68a4c
APPWRITE_API_KEY=
# FERNET_KEY: generate with `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FERNET_KEY=
# FERNET_KEY_OLD: comma-separated retired Fernet keys kept only to decrypt
# provider keys stored before a rotation. Never needed on first deploy.
FERNET_KEY_OLD=

# Persistence: Neon is the battle system of record. Appwrite is identity only
# (signup / session / JWT). Do not re-enable dual-write or read-fallback.
PERSISTENCE_BACKEND=postgres
APPWRITE_READ_FALLBACK=false
APPWRITE_DUAL_WRITE=false
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DATABASE_URL_MAIN=
DATABASE_URL_UNPOOLED_MAIN=
DATABASE_URL_DEV=
DATABASE_URL_UNPOOLED_DEV=

# Plan 2 — engines + judge
# INTERNAL_API_KEY: shared secret for sandbox → backend /internal/* (generate a long random string)
INTERNAL_API_KEY=
# Host-owned Kimi-K3 judge + playable Modal host model (modal_proxy)
JUDGE_MODAL_KEY=
JUDGE_MODAL_SECRET=
JUDGE_MODAL_BASE=https://inference.us-west.modal.direct/v1
JUDGE_MODAL_MODEL=sixscripts--ep-kimi-k3-server.us-west.modal.direct
# Host OpenRouter free-tier models. Never commit the real key.
HOST_OPENROUTER_KEY=
# Host OpenCode Go (deepseek-v4-flash) provider
HOST_OPENCODE_GO_KEY=
# Optional additional host backends (listed in GET /providers when set)
HOST_MERGE_KEY=
HOST_TOKENROUTER_KEY=
HOST_GROQ_KEY=
HOST_XAI_KEY=
HOST_DEEPSEEK_KEY=
HOST_OPENAI_KEY=
# Optional: public backend URL sandboxes call back to
BACKEND_PUBLIC_URL=https://sixscripts--agent-arena-backend-fastapi-app.modal.run
# ARENA_USE_MOCK must stay unset or 0 for live sandboxes. Tests already force it on.
# ARENA_USE_MOCK=1 forces mock_runner (tests default this on)
# Target verifier safety: verification commands from target manifests run ONLY
# inside the sandbox by default. Local/in-process runs (ARENA_INPROCESS_DIRECT=1)
# fail verification closed unless you explicitly opt in:
# ARENA_VERIFIER_ALLOW_INPROCESS=1
# ARENA_USE_MODAL_SANDBOX=1 enables Modal Sandbox spawn on battle create
# SANDBOX_TIMEOUT=900  # max seconds a spawned sandbox may live
# REAPER_GRACE_SECONDS=300  # extra time past battle timeout before a stuck battle is failed
